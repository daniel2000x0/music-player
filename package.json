{
  "name": "mi-music-player",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~58.1.0",
    "expo-alternate-app-icons": "^11.0.0",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.22",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-image": "~58.0.19",
    "expo-linking": "~58.0.17",
    "expo-media-library": "~58.0.14",
    "expo-router": "~58.0.33",
    "expo-splash-screen": "~58.0.15",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.23",
    "expo-web-browser": "~58.1.0",
    "expo-widgets": "~58.0.28",
    "lottie-react-native": "~7.5.0",
    "lucide-react-native": "^1.81.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-paper": "^5.15.5",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "expo-doctor": "^1.21.9",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "knip": "^6.48.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:go": "expo start --go",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "verify": "tsc --noEmit && expo lint && jest --runInBand --silent && expo-doctor",
    "build:apk": "npx --yes eas-cli@latest build -p android --profile production --non-interactive --wait",
    "check:coverage": "node scripts/check-coverage.js",
    "bench": "jest src/testing/bench --silent=false --verbose"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/src/testing/"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 90,
        "statements": 89,
        "branches": 84,
        "functions": 88
      }
    }
  },
  "private": true
}
