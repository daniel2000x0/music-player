{
  "expo": {
    "name": "Music",
    "slug": "mi-music-player",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mimusicplayer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.abelo.mimusicplayer"
    },
    "android": {
      "package": "com.abelo.mimusicplayer",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#0B0B0F",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": [
            "audio"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sqlite",
      "expo-asset",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "MediaWidget",
              "displayName": "Reproductor",
              "description": "Controla tu música desde la pantalla de inicio",
              "ios": null,
              "android": {
                "minWidth": 250,
                "minHeight": 140,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "horizontal",
                "initialLayout": "./src/widgets/media-widget.tsx"
              }
            }
          ]
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "IronMan",
            "ios": "./assets/images/launcher-icons/ironMan/ios.png",
            "android": {
              "foregroundImage": "./assets/images/launcher-icons/ironMan/android-foreground.png",
              "monochromeImage": "./assets/images/launcher-icons/ironMan/android-monochrome.png",
              "backgroundColor": "#1A0506"
            }
          },
          {
            "name": "Avengers",
            "ios": "./assets/images/launcher-icons/Avengers/ios.png",
            "android": {
              "foregroundImage": "./assets/images/launcher-icons/Avengers/android-foreground.png",
              "monochromeImage": "./assets/images/launcher-icons/Avengers/android-monochrome.png",
              "backgroundColor": "#1A1A1D"
            }
          },
          {
            "name": "CapitanAmerica",
            "ios": "./assets/images/launcher-icons/CapitanAmerica/ios.png",
            "android": {
              "foregroundImage": "./assets/images/launcher-icons/CapitanAmerica/android-foreground.png",
              "monochromeImage": "./assets/images/launcher-icons/CapitanAmerica/android-monochrome.png",
              "backgroundColor": "#1A1012"
            }
          },
          {
            "name": "SpiderMan",
            "ios": "./assets/images/launcher-icons/spiderman/ios.png",
            "android": {
              "foregroundImage": "./assets/images/launcher-icons/spiderman/android-foreground.png",
              "monochromeImage": "./assets/images/launcher-icons/spiderman/android-monochrome.png",
              "backgroundColor": "#1A0C0E"
            }
          },
          {
            "name": "Superman",
            "ios": "./assets/images/launcher-icons/superman/ios.png",
            "android": {
              "foregroundImage": "./assets/images/launcher-icons/superman/android-foreground.png",
              "monochromeImage": "./assets/images/launcher-icons/superman/android-monochrome.png",
              "backgroundColor": "#001E42"
            }
          },
          {
            "name": "GreenLantern",
            "ios": "./assets/images/launcher-icons/greenLantern/ios.png",
            "android": {
              "foregroundImage": "./assets/images/launcher-icons/greenLantern/android-foreground.png",
              "monochromeImage": "./assets/images/launcher-icons/greenLantern/android-monochrome.png",
              "backgroundColor": "#0D110D"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        },
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "fcdd74a2-6381-4def-8012-ca2330c6ca03"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fcdd74a2-6381-4def-8012-ca2330c6ca03"
    }
  }
}
